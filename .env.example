OMNI_API_KEY=
OMNI_API_URL=

# ---------------------------------------------------------------
# LLM via omniroute (OpenAI-compatible /v1/chat/completions).
# Key/URL = OMNI_* above; app config reads them as LLM_BASE_URL / LLM_API_KEY.
# Using subscription-backed cc/ (Claude) + cx/ (Codex/GPT) models.
# Pin exact model IDs (no auto/*) so results + cache stay stable.
# ---------------------------------------------------------------
LLM_API_COMPATIBILITY=openai_compatible

# Default model when a task has no specific setting
LLM_MODEL_ID=cc/claude-sonnet-5-5

# Per-task models
# category/region/keywords (fast, few tokens)
LLM_MODEL_TAGGING=cx/gpt-5.6-luna
# same/related/not-related suggestions
LLM_MODEL_CLUSTERING=cx/gpt-5.6-luna
# normalized event facts
LLM_MODEL_EXTRACTION=cc/claude-sonnet-5-5
# Thai brief (main quality task)
LLM_MODEL_SUMMARY=cc/claude-sonnet-5-5
# cross-day linkage + academy links
LLM_MODEL_RELATIONS=cc/claude-sonnet-5-5
# event -> Academy lesson links (optional; empty = LLM_MODEL_ID)
LLM_MODEL_ACADEMY_LINKING=

# Fallback: use the first one from a DIFFERENT vendor than the failed primary
# (cc/* fails -> cx/gpt-5.6-luna ; cx/* fails -> cc/claude-haiku-5-5)
LLM_MODEL_FALLBACK=cx/gpt-5.6-luna
LLM_MODEL_FALLBACK_SECONDARY=cc/claude-haiku-5-5

# Models that reject the temperature param (HTTP 400) - comma separated
LLM_OMIT_TEMPERATURE_FOR=cc/claude-haiku-5-5

# Limits (subscription quota: no per-token price, so cap tokens/requests)
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_TOKENS=32000
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TEMPERATURE=0.1
LLM_DAILY_MAX_REQUESTS=300
LLM_DAILY_MAX_TOKENS=600000

# App
APP_TIMEZONE=Asia/Bangkok
DATABASE_URL=file:./data/worldview.db
DAILY_EVENT_TARGET_MIN=10
DAILY_EVENT_TARGET_MAX=15

# ---------------------------------------------------------------
# pattern as shopee-affiliate / lra-solution on this machine).
# App has no published port; only reachable through the tunnel.
# ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=worldview
PUBLIC_HOSTNAME=worldview.nared-fu.com
PUBLIC_SITE_URL=https://worldview.nared-fu.com
# Deploy: Docker Compose + Cloudflare Tunnel (token-based, same

# SvelteKit adapter-node
# ORIGIN must match the public URL or form POSTs fail the CSRF check
ORIGIN=https://worldview.nared-fu.com
HOST=0.0.0.0
PORT=3000
# Real client IP behind Cloudflare (used for rate limiting / logs)
ADDRESS_HEADER=CF-Connecting-IP
BODY_SIZE_LIMIT=1M

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > Create (Cloudflared)
# Public hostname: worldview.nared-fu.com -> http://app:3000
TUNNEL_TOKEN=

# Cloudflare Access (protects /admin only; public pages stay open)
# Zero Trust > Access > Applications > Self-hosted: worldview.nared-fu.com/admin*
# App verifies the Cf-Access-Jwt-Assertion header against these
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Comma-separated admin emails allowed by the app (defence in depth)
ADMIN_ALLOWED_EMAILS=
